# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM API Keys
YANDEX_CLOUD_FOLDER = your_folder_id
# correct
YANDEX_CLOUD_API_KEY = your_api_key
# incorrect
#YANDEX_CLOUD_API_KEY = your_invalid_api_key
YANDEX_CLOUD_MODEL = "deepseek-v4-flash/latest"

# Database/Cache Settings
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=default
