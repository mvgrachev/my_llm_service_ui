# =============================================================================
# Application Environment
# =============================================================================
# Possible values: development, test, production
# Defaults to "development" if omitted.
APP_ENV=development

# =============================================================================
# Server
# =============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000

# =============================================================================
# Logging
# =============================================================================
# Overridden by environment (dev→DEBUG, test→WARNING, prod→INFO)
LOG_LEVEL=INFO
LOG_FORMAT=default
LOG_FILE=app.log

# =============================================================================
# LLM — Yandex Cloud / DeepSeek
# =============================================================================
YANDEX_CLOUD_FOLDER=your_folder_id
YANDEX_CLOUD_API_KEY=your_api_key
YANDEX_CLOUD_MODEL=deepseek-v4-flash/latest
YANDEX_CLOUD_BASE_URL=your_base_url
PROMPT=

# Per-environment defaults (can be overridden via env vars):
#   development — temperature=0.7, cache_ttl=0 (disabled), timeout=60s
#   test        — temperature=0.0, cache_ttl=0 (disabled), timeout=10s
#   production  — temperature=0.3, cache_ttl=600s,    timeout=30s
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_CACHE_TTL=600
DEEPSEEK_MAX_OUTPUT_TOKENS=1500
DEEPSEEK_TIMEOUT=30

# =============================================================================
# Redis / Cache
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# Network
# =============================================================================
NETWORK_CHECK_TIMEOUT=5

# =============================================================================
# Streamlit UI
# =============================================================================
FASTAPI_URL=http://localhost:8000
FASTAPI_TIMEOUT=60
